{
 "name": "geptyro-bot",
 "version": "1.12.0",
 "private": true,
 "description": "",
 "main": "index.js",
 "scripts": {
  "start": "echo $ENV && docker-compose -f docker-compose.$ENV.yml -p geptyro-bot-$ENV --profile $ENV --env-file ./envs/$ENV.env up",
  "stop": "docker-compose -f docker-compose.$ENV.yml -p geptyro-bot-$ENV --profile $ENV --env-file ./envs/$ENV.env down",
  "prod:start": "export ENV=prod && npm run start",
  "prod:stop": "export ENV=prod && npm run stop",
  "prod:restart": "npm run prod:stop && npm run prod:start",
  "dev:start": "export ENV=dev && node index"
 },
 "author": "",
 "license": "ISC",
 "dependencies": {
  "@discordjs/opus": "^0.9.0",
  "@discordjs/voice": "^0.17.0",
  "@distube/ytdl-core": "^4.14.4",
  "@googleapis/youtube": "^2.0.0",
  "axios": "^0.26.1",
  "discord.js": "^14.15.3",
  "moment": "^2.29.1",
  "mongodb": "^4.4.1",
  "open": "^8.4.0",
  "play-sound": "^1.1.6",
  "sodium": "^3.0.2",
  "sools-core": "1.14.0",
  "sools-core-server": "1.19.0"
 },
 "repository": {
  "type": "git",
  "url": "https://github.com/kanaxz/geptyro-bot.git"
 }
}